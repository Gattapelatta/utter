{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Utter",
  "version": "0.1.0",
  "identifier": "app.utter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Utter Overlay",
        "width": 440,
        "height": 230,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "resizable": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNjBBOUIyNkNCQTJERkIKUldUN0xicHNzcWxnMDBXSzVkVkd4UGw1NGFkVWova2syMlhzeTJqUmRpQStGMjJPUHhuOGFzdmUK",
      "endpoints": [
        "https://github.com/Gattapelatta/utter/releases/latest/download/latest.json"
      ]
    }
  }
}
